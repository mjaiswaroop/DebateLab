# Gemini Configuration
# NOTE: the Gemini 2.5 family is closed to new API keys and was shut down on
# 2026-10-20. Use a 3.x model id.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Tried in order if GEMINI_MODEL is retired or unavailable for your API key.
GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash-lite

# Database Configuration
# Default PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/debatelab
# Fallback SQLite for quick local development without Postgres:
DATABASE_URL=sqlite+aiosqlite:///./debatelab.db

# Security & App
SECRET_KEY=dev_secret_key_change_in_production_min_32_chars
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]
